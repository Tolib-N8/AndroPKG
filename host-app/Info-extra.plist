<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the generated Info.plist: keys the INFOPLIST_KEY_* settings cannot express. -->
<plist version="1.0">
<dict>
	<!-- Android shared storage (/storage/emulated/0) is Documents: "On My iPhone > AndroPkg" in
	     the Files app. (Xcode does not generate this key from INFOPLIST_KEY_UIFileSharingEnabled.) -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- Android music apps keep playing from a service while the app is in the background. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- APKs open in AndroPkg (Files, Safari downloads, the share sheet): the launcher installs them. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Android app</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.android.package-archive</string>
			</array>
		</dict>
		<!-- The signing certificate (.p12) for converting native libraries on the device. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Signing certificate</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.rsa.pkcs-12</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.android.package-archive</string>
			<key>UTTypeDescription</key>
			<string>Android app</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apk</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.android.package-archive</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- MediaPlayer streams plain-http radio and podcasts (AVFoundation is subject to ATS). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInMedia</key>
		<true/>
	</dict>
</dict>
</plist>
