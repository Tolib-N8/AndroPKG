<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.andropkg.test.components">
    <application android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".StartedService" android:exported="false" />
        <service android:name=".BoundService" android:exported="false" />
        <receiver android:name=".PingReceiver" android:exported="false">
            <intent-filter>
                <action android:name="dev.andropkg.test.PING" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
