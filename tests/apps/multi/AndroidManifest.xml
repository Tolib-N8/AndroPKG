<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.andropkg.test.multi">
    <application android:name=".App" android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <provider android:name=".NotesProvider" android:authorities="dev.andropkg.test.multi.notes"
            android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SecondActivity" android:exported="false">
            <intent-filter>
                <action android:name="dev.andropkg.test.multi.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
