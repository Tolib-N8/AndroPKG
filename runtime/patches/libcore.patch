+        int child_out = c->fds[1] != -1 ? c->fds[1] : out[1];
+        int child_err = redirectErrorStream ? child_out : (c->fds[2] != -1 ? c->fds[2] : err[1]);
+        /* The "process" gets its own copies; Finally closes ours as after a real fork. */
+        resultPid = andropkgExec()->spawn(pprog, c->argv, c->envv, c->pdir, dup(child_in), dup(child_out),
+                                          dup(child_err));
+        if (resultPid < 0) {
+            throwIOException(env, errno, "spawn failed");
+            goto Catch;
+        }
+        fds[0] = (in [1] != -1) ? in [1] : -1;
+        fds[1] = (out[0] != -1) ? out[0] : -1;
+        fds[2] = (err[0] != -1) ? err[0] : -1;
