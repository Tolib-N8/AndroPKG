 static jfieldID field_exitcode;
 
+#if defined(__APPLE__)
+/* andropkg: iOS has no fork/exec. An app's Android ELF executable (ProcessBuilder on a file
+ * from its native library dir) runs in-process instead (ndk-libs/exec.c in libandropkg_ndk). */
+#include <dlfcn.h>
+typedef struct {
+    int (*spawn)(const char *, const char *const *, const char *const *, const char *, int, int, int);
+    int (*wait)(int);
+    void (*kill)(int);
+} AndropkgExec;
+static const AndropkgExec *andropkgExec(void) {
+    static AndropkgExec e;
+    static int tried;
+    if (!tried) {
+        tried = 1;
+        void *h = dlopen("@rpath/libandropkg_ndk.dylib", RTLD_NOW | RTLD_GLOBAL);
+        if (h) {
+            e.spawn = (int (*)(const char *, const char *const *, const char *const *, const char *, int, int, int))
+                dlsym(h, "andropkg_ndk_spawn");
+            e.wait = (int (*)(int))dlsym(h, "andropkg_ndk_wait");
+            e.kill = (void (*)(int))dlsym(h, "andropkg_ndk_kill");
+        }
+    }
+    return e.spawn && e.wait && e.kill ? &e : NULL;
+}
+static int isAndroidElf(const char *path) {
+    unsigned char m[4] = {0};
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0) return 0;
+    int ok = read(fd, m, 4) == 4 && m[0] == 0x7f && m[1] == 'E' && m[2] == 'L' && m[3] == 'F';
+    close(fd);
+    return ok;
