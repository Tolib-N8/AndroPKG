+#if defined(__APPLE__)
+// andropkg: ANDROPKG_LOG_HTTP=1 (debugging an app's network traffic without a proxy or its
+// tokens): HTTP/2 is not offered (ALPN), so apps speak HTTP/1.1, and the request line (no query)
+// with its Host, and the response status line, are logged. Headers and bodies are not.
+static bool andropkg_log_http() {
+    static const bool on = getenv("ANDROPKG_LOG_HTTP") != nullptr;
+    return on;
+}
+static void andropkg_http_line(const char* buf, int len, bool out) {
+    if (!andropkg_log_http() || len <= 0) return;
+    static const char* kMethods[] = {"GET ", "POST ", "PUT ", "DELETE ", "PATCH ", "HEAD ", "HTTP/1."};
+    bool match = false;
+    for (const char* m : kMethods) {
+        size_t n = strlen(m);
+        if (static_cast<size_t>(len) >= n && memcmp(buf, m, n) == 0) match = true;
+    }
+    if (!match) return;
+    int end = 0;
+    while (end < len && end < 300 && buf[end] != '\r' && buf[end] != '\n') end++;
+    std::string line(buf, static_cast<size_t>(end));
+    if (out) {
+        size_t q = line.find('?');
+        size_t sp = line.rfind(' ');
+        if (q != std::string::npos && sp != std::string::npos && q < sp) line.erase(q, sp - q);
+        const char* host = static_cast<const char*>(memmem(buf, static_cast<size_t>(len), "\r\nHost: ", 8));
+        if (host != nullptr) {
+            const char* h = host + 8;
+            const char* e = h;
+            while (e < buf + len && *e != '\r') e++;
+            line += "  [" + std::string(h, static_cast<size_t>(e - h)) + "]";
+        }
+    }
+    __android_log_print(ANDROID_LOG_INFO, "andropkg-http", "%s %s", out ? ">>" : "<<", line.c_str());
+}
+#else
+static bool andropkg_log_http() { return false; }
+static void andropkg_http_line(const char*, int, bool) {}
+#endif
